	"SetCVar",
	"Settings",
	"SettingsPanel",
	"ShowUIPanel",
	"StaticPopup1",
	"StaticPopupDialogs",
	"StaticPopup_FindVisible",
	"StaticPopup_Show",
	"TooltipDataProcessor",
	"TooltipUtil",
	"UIParent",
	"UnitClass",
	"UnitLevel",
	"UnitRace",
	"WorldFrame",
	"YES",
	"bit",
	"hooksecurefunc",
	"wipe",
}
globals = {
	"BINDING_NAME_MAGICERASER_ADD_TO_ERASE_LIST",
	"BINDING_NAME_MAGICERASER_ADD_TO_IGNORE_LIST",
	"BINDING_NAME_MAGICERASER_ERASE",
