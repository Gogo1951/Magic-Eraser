	"DeleteCursorItem",
	"Enum",
	"GAMEMENU_OPTIONS",
	"GameTooltip",
	"GetBindingKey",
	"GetBindingText",
	"GetBuildInfo",
	"GetCVar",
	"GetCursorInfo",
	"GetLocale",
	"GetPhysicalScreenSize",
	"GetTime",
	"ITEM_QUALITY3_DESC",
	"InCombatLockdown",
	"IsShiftKeyDown",
	"KEY_BINDINGS",
	"KeyBindingFrame",
	"KeyBindingFrame_LoadUI",
	"LibStub",
	"MailFrame",
	"MerchantFrame",
	"NO",
	"NUM_BAG_SLOTS",
	"NUM_BANKBAGSLOTS",
	"PlaySound",
